# Copy to .env locally. Never commit .env or real provider credentials.
APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/property_connect
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/property_connect

# Transactional email (Resend SMTP is the selected production adapter)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Property Connect <no-reply@example.com>

# Paynow integration credentials and callback URLs
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
# In test mode this must be the email address of the Paynow merchant account.
PAYNOW_MERCHANT_EMAIL=
PAYNOW_RESULT_URL=http://localhost:3000/api/paynow/result
PAYNOW_RETURN_URL=http://localhost:3000/payment/return
PAYNOW_MODE=test

# Cloudflare R2. Use separate buckets and credentials for media and locked audit archives.
R2_ACCOUNT_ID=
R2_MEDIA_ACCESS_KEY_ID=
R2_MEDIA_SECRET_ACCESS_KEY=
R2_MEDIA_BUCKET=
R2_AUDIT_ACCESS_KEY_ID=
R2_AUDIT_SECRET_ACCESS_KEY=
R2_AUDIT_BUCKET=
R2_PUBLIC_BASE_URL=

# AWS KMS asymmetric key, ECC_NIST_P256 with SIGN_VERIFY. Limit IAM to kms:Sign and kms:GetPublicKey.
AUDIT_SIGNER_PROVIDER=aws-kms
AUDIT_SIGNER_REGION=
AUDIT_SIGNER_KEY_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Used to hash client IPs before rate-limit/audit storage.
IP_HASH_SECRET=replace-with-a-separate-random-secret
CARD_CODE_PEPPER=replace-with-a-separate-random-secret
CRON_SECRET=replace-with-a-long-random-secret
