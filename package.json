    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "better-auth": "1.7.7",
    "dotenv": "^16.4.7",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^0.468.0",
    "next": "16.3.8",
